# Supabase — preencher após a criação/definição do projeto Supabase para o Regtech Motos.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ATENÇÃO ao configurar as variáveis diretamente no painel da Vercel:
# a Vercel já traduziu automaticamente o valor de NEXT_PUBLIC_SUPABASE_ANON_KEY
# para o português em projetos anteriores. Se isso acontecer, apague a variável
# e recrie manualmente digitando o valor original em inglês.

# URL pública do site em produção (ex: https://regtech-motos-app.vercel.app).
# Usada para metadataBase, canonical, Open Graph, sitemap e robots. Sem essa
# variável configurada, essas funcionalidades ficam com fallback vazio/neutro
# — nunca é usado um domínio inventado no lugar dela.
NEXT_PUBLIC_SITE_URL=

# Número de WhatsApp (com DDI, apenas dígitos, ex: 5594999999999) para onde o
# fluxo "Tenho interesse" direciona o cliente. Sem essa variável configurada,
# o lead é salvo normalmente, mas o WhatsApp não abre — nunca é usado um
# número fictício no lugar dela.
NEXT_PUBLIC_WHATSAPP_NUMBER=
